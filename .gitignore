# Reference genome files (large, download separately — do NOT commit)
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.fai
*.dict

# Annotation files (download separately)
*.gtf
*.gtf.gz
*.gff
*.gff3
*.gff3.gz

# Genome size / index helpers generated by the pipeline
genome.txt

# Generated intermediate and output BED files
# (the curated examples/ files are committed explicitly and excluded below)
PANEL.GRCh37.exons.raw.bed
PANEL.GRCh37.exons.sorted.bed
PANEL.GRCh37.exons.plus20bp.raw.bed
PANEL.GRCh37.exons.plus20bp.bed
PANEL.GRCh37.exons.plus20bp.chr.bed
*.raw.bed
*.sorted.bed

# Keep the curated example outputs and committed data, even if patterns above match
!examples/*.bed
!data/*.bed

# Working directory created by the instructions
PANEL_BED_GRCh37/

# Alignment / variant files (never commit patient data)
*.bam
*.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.vcf.gz.tbi

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
